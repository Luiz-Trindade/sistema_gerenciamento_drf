# ==========================================================================
# .gitignore
# ==========================================================================

# --------------------------------------------------------------------------
# Python: bytecode, builds, distribuição
# --------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*py.class

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-wheel-metadata/

# ⚠️ Removidos de propósito: lib/ e lib64/
# Só inclua se você realmente tem uma pasta `lib/` no root que NUNCA deve ser versionada.
# Em projetos Django, `lib/` costuma ser código de terceiros local — normalmente versionado.

# --------------------------------------------------------------------------
# Ambientes virtuais
# --------------------------------------------------------------------------
.venv/
.venv*/
venv/
env/
ENV/
env.bak/
venv.bak/
virtualenv/
pyvenv.cfg
.env_folder/

# --------------------------------------------------------------------------
# Caches de ferramentas Python
# --------------------------------------------------------------------------
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/
.hypothesis/
.tox/
.nox/
.dmypy.json
dmypy.json
.monkeytype/
ipython/

# --------------------------------------------------------------------------
# Django / banco local / mídia
# --------------------------------------------------------------------------
*.log
*.log.*
logs/
local_settings.py
settings_local.py
*_local.py
# !local_settings.py.example   # descomente se versionar um exemplo

db.sqlite3
db.sqlite3-journal
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal

media/
mediafiles/

# staticfiles/ normalmente NÃO deve ser versionado
staticfiles/
static_root/

# Celery / agendadores
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid
*.pid

# Traduções: mantenha .po no Git; .mo é gerado
*.mo

# --------------------------------------------------------------------------
# Variáveis de ambiente e SEGREDOS
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.env
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks
credentials.json
service-account*.json

# --------------------------------------------------------------------------
# Dumps e backups de banco (padrões ESPECÍFICOS — não ignore *.sql em geral)
# --------------------------------------------------------------------------
dump*.sql
dump*.sql.gz
backup*.sql
backup*.sql.gz
*.dump
*.bak
backup_dados.json
backup*.json

# --------------------------------------------------------------------------
# Docker
# --------------------------------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
docker-compose.*.local.yml
# !docker-compose.override.example.yml   # descomente se versionar um exemplo

# Volumes locais de banco de dados
/pgdata/
/postgres_data/
/db_data/
/data/db/
/mysql_data/
/mongo_data/
/redis_data/

# --------------------------------------------------------------------------
# Testes e cobertura
# --------------------------------------------------------------------------
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
*.cover
*.py,cover
junit*.xml
test-results/
reports/

# --------------------------------------------------------------------------
# IDEs e editores
# --------------------------------------------------------------------------
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json
.idea/
*.iws
*.iml
*.ipr
.fleet/
.spyderproject
.ropeproject
.history/
*.code-workspace
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# Editores modernos
.cursor/
.zed/
.windsurf/
.cursorrules

# --------------------------------------------------------------------------
# Sistema operacional
# --------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Icon
**/.Trash-*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
**/lost+found

# --------------------------------------------------------------------------
# Node / frontend (remova se não tiver)
# --------------------------------------------------------------------------
node_modules/
jspm_packages/
.npm/
.yarn/
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npmrc
.yarnrc.yml
.parcel-cache/
.sass-cache/
.next/
.nuxt/
.vuepress/dist/
storybook-static/

# --------------------------------------------------------------------------
# Ferramentas de projeto
# --------------------------------------------------------------------------
.python-version
.tool-versions
.direnv/
.envrc
.ruff.toml.bak
.mypy.ini.bak